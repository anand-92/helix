# Anthropic API key (optional)
# If you have a Claude Code OAuth subscription, you do NOT need to set this.
# The Claude Agent SDK will use your subscription automatically.
# Set this only if you want to use a direct Anthropic API key instead.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Enable persistent memory
# MEMORY_ENABLED=false
# GEMINI_API_KEY=your_gemini_api_key_here
